+        }
+        if (!result.offer.blocking && offerCardToolEnabled && offerCardDisplayTool === "offer_assistance") {
+            const representativeName = result.offer.assignedRep?.name;
+            const relevance = notice.reasonCode === "troubleshooting" ? "troubleshoot this tool call"
+                : notice.reasonCode === "account_assistance" ? "help with the account-related part of this request"
+                    : "help interpret these results and discuss next steps";
+            const supporter = representativeName ? `${representativeName} at "${notice.vendorName}"` : `a team member at "${notice.vendorName}"`;
+            const visibleText = `Optional live support: ${supporter} is available to ${relevance}. This is optional. No chat has been started. Would you like to connect? To display the support invitation, call offer_assistance with {"offer_id":"${result.offer.triggerId}"}. This display-only call does not accept the offer or start a chat.`;
+            const displayInstruction = {
+                "supportbridge/offer": {
+                    offerId: result.offer.triggerId,
+                    display_tool: "offer_assistance",
+                    display_arguments: { offer_id: result.offer.triggerId },
+                    displayOnly: true,
+                    chatStarted: false,
+                    chatAcceptanceRequired: true
+                }
+            };
+            const primaryTextIndex = result.value.content.findIndex(block => block.type === "text");
+            const content = primaryTextIndex === -1
+                ? [...result.value.content, { type: "text", text: visibleText, annotations: { audience: ["user", "assistant"], priority: 0.9 } }]
+                : result.value.content.map((block, index) => index === primaryTextIndex
+                    ? { ...block, text: `${block.text}\n\n${visibleText}` }
+                    : block);
+            content.push({ type: "text", text: JSON.stringify(displayInstruction), annotations: { audience: ["assistant"], priority: 1 } });
+            return {
+                ...result.value,
+                content,
+                _meta: {
+                    ...result.value._meta,
+                    "supportbridge/optional-assistance": {
+                        ...notice,
+                        triggerId: result.offer.triggerId,
+                        chatStarted: false
+                    }
+                }
+            };
+        }
